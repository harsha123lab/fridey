FRIDEY_APP_NAME=FRIDEY AI Service
FRIDEY_OLLAMA_BASE_URL=http://127.0.0.1:11434
FRIDEY_OLLAMA_MODEL=qwen2.5:3b
FRIDEY_VERCEL_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
FRIDEY_VERCEL_MODEL=alibaba/qwen-3-30b
# auto = try cloud Qwen first when a key exists, then fall back to local Ollama
# cloud = same cloud-first behavior; local = use only local Ollama
FRIDEY_AI_PROVIDER=auto
FRIDEY_REQUEST_TIMEOUT_SECONDS=90
FRIDEY_ENABLE_WEB_SEARCH=true
FRIDEY_ALLOW_DESKTOP_ACTIONS=true

# Set ONE of these in your local .env (never commit real keys):
# AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key
# VERCEL_OIDC_TOKEN=provided automatically in supported Vercel deployments
