FRIDEY_APP_NAME=FRIDEY AI Service
FRIDEY_OLLAMA_BASE_URL=http://127.0.0.1:11434
FRIDEY_OLLAMA_MODEL=qwen2.5:3b
FRIDEY_VERCEL_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
FRIDEY_VERCEL_MODEL=alibaba/qwen-3-30b
FRIDEY_AI_PROVIDER=auto
FRIDEY_REQUEST_TIMEOUT_SECONDS=90
FRIDEY_ENABLE_WEB_SEARCH=true
FRIDEY_ALLOW_DESKTOP_ACTIONS=true
# Secrets go only in local .env. Never commit real keys.
# AI_GATEWAY_API_KEY=your_vercel_gateway_key
# Optional Meta WhatsApp Cloud API:
# WHATSAPP_ACCESS_TOKEN=your_meta_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Optional SMTP email (use an app password):
# FRIDEY_SMTP_HOST=smtp.example.com
# FRIDEY_SMTP_PORT=587
# FRIDEY_SMTP_USERNAME=you@example.com
# FRIDEY_SMTP_PASSWORD=your_app_password
# FRIDEY_EMAIL_FROM=you@example.com
# Optional offline voice: download/extract a Vosk model separately
# VOSK_MODEL_PATH=C:\\models\\vosk-model-small-en-us-0.15
# FRIDEY_OFFLINE_VOICE=true
